# build output (the exe goes to GitHub Releases, not the repo)
build/
dist/
build-*/
dist-*/
*.exe
__pycache__/
*.pyc
*.egg-info/

# what Buddy writes while it runs
*.log
*.ctl
*.tmp
*.bak

