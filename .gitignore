cache-buddy-src/CcCacheBuddy.spec
cache-buddy-src/DevinCacheBuddy.spec
cache-buddy-src/make_dist.py
cache-buddy-src/dist_*
cache-buddy-src/_*.py
cache-buddy-src/test_cc_buddy.py
cache-buddy-src/demo_shots.py
cache-buddy-src/cdp-*
cache-buddy-src/promo/
